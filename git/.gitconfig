[user]
	email = git@ahmedz.dev
	name = Ahmed Zougari
[init]
	defaultBranch = main
[core]
	editor = vim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true       # n / N jump between files
	line-numbers = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
# [diff]
# 	algorithm = histogram
# [pull]
# 	rebase = true
[alias]
	st = status -sb
	lg = log --oneline --graph --decorate --all
	last = log -1 --stat
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit
	pushf = push --force-with-lease
	unstage = restore --staged
